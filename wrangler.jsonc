{
  // Must match the name of your existing Worker if you deploy from GitHub,
  // otherwise Cloudflare creates a second Worker.
  "name": "civic-services-demo",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Run the Worker for every request so it can check the session first
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "civic-services-db",
      "database_id": "46f379ee-90e0-400c-8d66-cdadbb5b5331"
    }
  ],
  "routes": [
    { "pattern": "dcs.shaffernet.net", "custom_domain": true }
  ]
}